# Firebase client config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Postgres
# Local default after creating a database named josealo:
# DATABASE_URL=postgres://localhost:5432/josealo
DATABASE_URL=
USE_POSTGRES_LISTINGS=false
USE_POSTGRES_PROFILES=false
USE_POSTGRES_SOCIAL=false
USE_POSTGRES_CHATS=false
USE_POSTGRES_SALES=false
USE_POSTGRES_ADMIN=false
USE_POSTGRES_ADS=false
USE_POSTGRES_ANALYTICS=false
USE_POSTGRES_AUTH=false

# Google OAuth
# Add this redirect URI in Google Cloud Console:
# http://localhost:3000/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Listing image uploads
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
NEXT_PUBLIC_AWS_S3_PUBLIC_BASE_URL=

# Optional image moderation thresholds
NSFW_BLOCK_HENTAI_THRESHOLD=
NSFW_BLOCK_PORN_THRESHOLD=
NSFW_BLOCK_SEXY_THRESHOLD=

# Admin session cookie signing
ADMIN_SESSION_SECRET=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
