rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isParticipant(chatData) {
      return isSignedIn()
        && (
          chatData.buyerId == request.auth.uid ||
          chatData.sellerId == request.auth.uid
        );
    }

    function isOwnDocument(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isReportParticipant(reportData) {
      return isSignedIn()
        && (
          reportData.reporterId == request.auth.uid ||
          reportData.sellerId == request.auth.uid ||
          reportData.targetUserId == request.auth.uid
        );
    }

    function isReviewRequestParticipant(requestData) {
      return isSignedIn()
        && (
          requestData.buyerId == request.auth.uid ||
          requestData.sellerId == request.auth.uid
        );
    }

    function publicProfileKeys() {
      return [
        'displayName',
        'name',
        'avatarUrl',
        'instagramUsername',
        'description',
        'profileDescription',
        'updatedAt',
        'updatedAtServer'
      ];
    }

    function hasOnlyPublicProfileFields() {
      return request.resource.data.keys().hasOnly(publicProfileKeys());
    }

    function optionalString(field, maxLength) {
      return !request.resource.data.keys().hasAny([field])
        || (
          request.resource.data[field] is string
          && request.resource.data[field].size() <= maxLength
        );
    }

    function hasValidPublicProfileFields() {
      return optionalString('displayName', 30)
        && optionalString('name', 30)
        && optionalString('avatarUrl', 500)
        && optionalString('instagramUsername', 30)
        && optionalString('description', 120)
        && optionalString('profileDescription', 120);
    }

    function serverManagedListingSaleFields() {
      return [
        'status',
        'soldAt',
        'soldAtServer',
        'soldWithJosealo',
        'saleSpeedRating',
        'lastSoldAt',
        'lastSoldAtServer',
        'bazarItems',
        'image',
        'searchTokens'
      ];
    }

    match /listings/{listingId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverManagedListingSaleFields());

      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read: if isParticipant(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.listingId is string
        && request.resource.data.listingTitle is string
        && request.resource.data.listingPrice is number
        && request.resource.data.buyerName is string
        && request.resource.data.sellerName is string;

      allow update: if isParticipant(resource.data)
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.listingId == resource.data.listingId;
    }

    match /messages/{messageId} {
      allow read: if isSignedIn()
        && exists(/databases/$(database)/documents/chats/$(resource.data.chatId))
        && isParticipant(
          get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data
        );

      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.chatId is string
        && request.resource.data.text is string
        && (
          !request.resource.data.keys().hasAny(['imageUrl']) ||
          request.resource.data.imageUrl is string
        )
        && request.resource.data.senderRole in ['buyer', 'seller']
        && exists(/databases/$(database)/documents/chats/$(request.resource.data.chatId))
        && isParticipant(
          get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data
        );
    }

    match /userProfiles/{userId} {
      allow read: if true;

      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && hasOnlyPublicProfileFields()
        && hasValidPublicProfileFields();
    }

    match /userPrivateProfiles/{userId} {
      allow read, create, update, delete: if isOwnDocument(userId);
    }

    match /userPresence/{userId} {
      allow read: if isSignedIn();

      allow create, update: if isOwnDocument(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.lastActiveAt is number;

      allow delete: if false;
    }

    match /userLocations/{userId} {
      allow read, delete: if isOwnDocument(userId);

      allow create, update: if isOwnDocument(userId)
        && request.resource.data.userId == request.auth.uid;
    }

    match /businessProfiles/{userId} {
      allow read, delete: if isOwnDocument(userId);

      allow create, update: if isOwnDocument(userId)
        && request.resource.data.userId == request.auth.uid;
    }

    match /likes/{likeId} {
      allow read: if isSignedIn()
        && (
          resource.data.actorId == request.auth.uid ||
          resource.data.ownerId == request.auth.uid
        );

      allow create, update: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.ownerId is string
        && request.resource.data.listingId is string
        && exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId))
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerId == request.resource.data.ownerId
        && request.resource.data.itemTitle is string
        && request.resource.data.price is number;

      allow delete: if isSignedIn()
        && resource.data.actorId == request.auth.uid;
    }

    match /follows/{followId} {
      allow read: if true;

      allow create, update: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followeeId is string
        && request.resource.data.followeeId != request.auth.uid
        && request.resource.data.followerName is string
        && request.resource.data.followeeName is string;

      allow delete: if isSignedIn()
        && resource.data.followerId == request.auth.uid;
    }

    match /searchEvents/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.query is string
        && request.resource.data.normalizedQuery is string
        && request.resource.data.category is string
        && request.resource.data.location is string
        && request.resource.data.source in ['search', 'category', 'home']
        && request.resource.data.createdAt is number
        && request.resource.data.keys().hasOnly([
          'query',
          'normalizedQuery',
          'category',
          'location',
          'userId',
          'source',
          'createdAt',
          'createdAtServer'
        ]);

      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow update, delete: if false;
    }

    match /supportNotifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'read',
          'readAt',
          'readAtServer'
        ]);

      allow create, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if isReportParticipant(resource.data);
      allow create, update, delete: if false;
    }

    match /listingViewEvents/{eventId} {
      allow read: if isSignedIn()
        && (
          resource.data.ownerId == request.auth.uid ||
          resource.data.viewerId == request.auth.uid
        );

      allow create, update, delete: if false;
    }

    match /listingSoldEvents/{eventId} {
      allow read: if isSignedIn()
        && (
          resource.data.ownerId == request.auth.uid ||
          resource.data.soldToUserId == request.auth.uid
        );

      allow create, update, delete: if false;
    }

    match /purchaseReviewRequests/{requestId} {
      allow read: if isReviewRequestParticipant(resource.data);
      allow create, update, delete: if false;
    }

    match /userRatings/{ratingId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }
}
